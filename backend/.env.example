# Backend environment variables — NAMES ONLY (NFR-1). Copy to .env and fill in real values
# locally; .env is git-ignored and must never be committed.

# PostgreSQL connection string (Prisma)
DATABASE_URL=

# Redis connection string backing the BullMQ sync queues
REDIS_URL=

# GitHub provider adapter — absence disables GitHub sync (worker logs once, does not crash)
GITHUB_TOKEN=
GITHUB_REPO=

# Jira provider adapter — absence disables Jira sync (worker logs once, does not crash)
JIRA_API_TOKEN=
JIRA_BASE_URL=
JIRA_PROJECT_KEY=

# Single-origin CORS allowlist for the frontend (SEC-2)
FRONTEND_ORIGIN=

# HTTP server port
PORT=

# Per-provider worker concurrency; default 1 (serial per lane) — see docs/MDP-7/04-impl-plan.md M6
QUEUE_CONCURRENCY=
