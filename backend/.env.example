# Postgres (Prisma) — required to run the API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task_manager?schema=public"

# Redis (BullMQ) — required to run the sync queue/worker
REDIS_URL="redis://localhost:6379"

# HTTP
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# --- Sync targets (TBD per phase-02-architecture.md Config section) ---
# Do NOT fabricate values here. Leave unset until the real project
# key / repo is confirmed; provider calls are stubbed (T-4/T-5 out of
# scope) and will no-op/log rather than fail if these are unset.
JIRA_PROJECT_KEY=
JIRA_API_TOKEN=
JIRA_BASE_URL=
GITHUB_REPO=
GITHUB_TOKEN=

# --- Sync queue tuning (T-3) ---
SYNC_MAX_ATTEMPTS=5
SYNC_BACKOFF_MS=2000
