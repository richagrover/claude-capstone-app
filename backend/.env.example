# Backend environment variables — NAMES ONLY (NFR-1). Copy to .env and fill in real values
# locally; .env is git-ignored and must never be committed.

# PostgreSQL connection string (Prisma)
DATABASE_URL=

# Redis connection string backing the BullMQ sync queues
REDIS_URL=

# GitHub provider adapter — absence disables GitHub sync (worker logs once, does not crash)
GITHUB_TOKEN=
GITHUB_REPO=

# Jira provider adapter — absence disables Jira sync (worker logs once, does not crash)
JIRA_API_TOKEN=
JIRA_BASE_URL=
JIRA_PROJECT_KEY=

# Single-origin CORS allowlist for the frontend (SEC-2)
FRONTEND_ORIGIN=

# Reverse-proxy trust for the /api rate limiter's client-IP keying (resolves SEC-6). Leave
# unset for direct-connect local/dev (default: do not trust any proxy). In production behind
# a reverse proxy/load balancer, set to the number of trusted hops in front of this process
# (typically 1) so express-rate-limit keys by the real client IP from X-Forwarded-For instead
# of the proxy's IP. Only set this to a value that matches your actual trusted deployment
# topology — trusting an untrusted proxy chain lets a client spoof X-Forwarded-For to evade
# the rate limit.
TRUST_PROXY=

# HTTP server port
PORT=

# Per-provider worker concurrency; default 1 (serial per lane) — see docs/MDP-7/04-impl-plan.md M6
QUEUE_CONCURRENCY=
