// Prisma schema for the Task Manager application.
// Contract source: docs/MDP-7/02-architecture.md §4; indexes resolve design-review findings
// B-4 (filter-column indexes) and B-1 (sync-health aggregate index).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  Backlog
  InProgress
  InReview
  Done
}

enum TaskPriority {
  Low
  Medium
  High
}

enum SyncProvider {
  github
  jira
}

enum SyncResult {
  ok
  failed
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(Backlog)
  priority    TaskPriority @default(Medium)
  assignee    String?
  dueDate     DateTime?
  labels      String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Resolves B-4: indexes on every GET /tasks filter column.
  @@index([status])
  @@index([assignee])
  @@index([priority])
  @@map("tasks")
}

// Current sync state, one row per (taskId, provider). `taskId` is intentionally a plain column
// (no @relation / enforced FK to Task) — see docs/MDP-7/02-architecture.md §4 rationale: a
// task-delete must still be able to write a "close" result here after the Task row is gone.
model SyncLink {
  id               String      @id @default(uuid())
  taskId           String
  provider         SyncProvider
  externalKeyOrUrl String?
  lastSyncedAt     DateTime?
  lastStatus       SyncResult?
  lastError        String?

  @@unique([taskId, provider])
  // Resolves B-1: backs the GROUP BY provider, lastStatus sync-health aggregate.
  @@index([provider, lastStatus])
  @@map("sync_links")
}

// Append-only audit trail of every sync attempt. Same unenforced-taskId rationale as SyncLink.
model SyncAttempt {
  id        String       @id @default(uuid())
  taskId    String
  provider  SyncProvider
  timestamp DateTime     @default(now())
  result    SyncResult
  detail    String?

  @@index([taskId])
  @@map("sync_attempts")
}
